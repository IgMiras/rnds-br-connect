    <differential>
        <element id="Composition">
            <path value="Composition" />
            <short value="Conjunto Mínimo de Dados" />
            <definition value="Documento que representa o Conjunto Mínimo de Dados." />
            <alias value="Contato Assistencial" />
            <alias value="CMD" />
            <alias value="Minimum Health Data Set" />
            <alias value="Minimum Basic Health Data Set" />
            <alias value="MHDS" />
            <alias value="MBHDS" />
            <alias value="Atendimento" />
            <alias value="Internação" />
            <mustSupport value="true" />
            <constraint>
                <key value="opm-1" />
                <severity value="error" />
                <human
                    value="Caso a Modalidade Assistencial seja 01, 02, 05 ou 07 e o código do Procedimento seja 0702100030, 0702100072, 0702100048, 0702100064, 0702100056 ou 0702100080, então as informações do Número da Nota Fiscal (SupplyDelivery.identifier.value), CNPJ do Fornecedor (SupplyDelivery.supplier.identifier.value) e Lote de Fabricação da OPM (Device.lotNumber) devem ser preenchidas." />
                <expression
                    value="section.entry.resolve().ofType(Procedure).all(code.coding.exists(code in '0702100030'|'0702100072'|'0702100048'|'0702100064'|'0702100056'|'0702100080') and %context.category.coding.exists(code in '01'|'02'|'05'|'07') implies focalDevice.manipulated.exists(reference in (%context.section.entry.resolve().ofType(SupplyDelivery).suppliedItem.item.reference))) " />
            </constraint>
            <constraint>
                <key value="opm-2" />
                <severity value="error" />
                <human
                    value="Caso a Modalidade Assistencial seja igual a 04 e o código do Procedimento seja do SubGrupo 0702, então as informações do Número da Nota Fiscal (SupplyDelivery.identifier.value), CNPJ do Fornecedor (SupplyDelivery.supplier.identifier.value) e Lote de Fabricação da OPM (Device.lotNumber) devem ser preenchidas. Exceto para os Procedimentos 0702020028, 0702020036, 0702020044 ou quando a Forma de Organização for 070210." />
                <expression
                    value="section.entry.resolve().ofType(Procedure).all(code.coding.exists((code.startsWith('0702') and code.startsWith('070210').not()) and (code in '0702020028'|'0702020036'|'0702020044').not()) and %context.category.coding.exists(code = '04') implies focalDevice.manipulated.exists(reference in (%context.section.entry.resolve().ofType(SupplyDelivery).suppliedItem.item.reference))) " />
            </constraint>
            <constraint>
                <key value="opm-3" />
                <severity value="error" />
                <human
                    value="Caso a Modalidade Assistencial seja igual a 03 ou 06 e o código do Procedimento seja do SubGrupo 0702, então as informações do Número da Nota Fiscal (SupplyDelivery.identifier.value), CNPJ do Fornecedor (SupplyDelivery.supplier.identifier.value) e Lote de Fabricação da OPM (Device.lotNumber) devem ser preenchidas. Exceto para os Procedimentos 0702100013, 0702100021, 0702100099, 0702100102, 0702020028, 0702020036 e 0702020044." />
                <expression
                    value="section.entry.resolve().ofType(Procedure).all(code.coding.exists(code.startsWith('0702') and (code in '0702100013'|'0702100021'|'0702100099'|'0702100102'|'0702020028'|'0702020036'|'0702020044').not()) and %context.category.coding.exists(code in '03'|'06') implies focalDevice.manipulated.exists(reference in (%context.section.entry.resolve().ofType(SupplyDelivery).suppliedItem.item.reference))) " />
            </constraint>
            <constraint>
                <key value="cbo-1" />
                <severity value="error" />
                <human
                    value="O Procedimento informado possui CBO ou Família de CBO vinculada, sendo necessário o preenchimento em Procedure.performer.function." />
                <expression
                    value="section.entry.resolve().ofType(Procedure).all($this.code.coding.code.memberOf('http://www.saude.gov.br/fhir/r4/ValueSet/BRProcedimentosComCBO') implies performer.function.exists())" />
            </constraint>
        </element>
